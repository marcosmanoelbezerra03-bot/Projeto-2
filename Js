const botao = document.querySelector("#btn-nova");
const botaoCopiar = document.querySelector("#btn-copiar");
const texto = document.querySelector("#texto-frase");
const autor = document.querySelector("#autor-frase");
const contador = document.querySelector("#contador");
const mensagem = document.querySelector("#mensagem");

let quantidadeGerada = 0;
let indiceAnterior = -1;

function gerarFrase() {
    let indice;

    do {
        indice = Math.floor(Math.random() * frases.length);
    } while (indice === indiceAnterior);

    indiceAnterior = indice;

    texto.innerText = frases[indice].texto;
    autor.innerText = "— " + frases[indice].autor;

    quantidadeGerada++;

    contador.innerText =
        "Frases geradas: " + quantidadeGerada;

    mensagem.innerText = "";
}

botao.addEventListener("click", gerarFrase);

botaoCopiar.addEventListener("click", async function () {
    const fraseCompleta =
        texto.innerText + " " + autor.innerText;

    try {
        await navigator.clipboard.writeText(fraseCompleta);
        mensagem.innerText = "Frase copiada!";
    } catch (erro) {
        mensagem.innerText =
            "Não foi possível copiar. Tente pelo navegador.";
    }
});

// Exibe uma frase ao abrir a página.
gerarFrase();
